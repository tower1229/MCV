{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCV profiles document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "required": ["global"],
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
      },
      "properties": {
        "global": { "$ref": "#/$defs/profile" }
      },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
